# Copy to .env locally if you want. This file is an example only.
# The app does not auto-load .env. Export variables yourself.
# Never commit .env. Never put a real key in this file.

# Default is offline. Set to 0 only for a manual refresh-snapshots run.
EVENTS_OFFLINE=1

SOCRATA_BASE_URL=https://data.cityofnewyork.us
# Optional. Empty means no app token. Public SODA works without one.
SOCRATA_APP_TOKEN=
SOCRATA_TIMEOUT_S=15
SOCRATA_MAX_ATTEMPTS=3
SOCRATA_BACKOFF_CAP_S=2
SOCRATA_BACKOFF_BASE_S=0.25
SOCRATA_CACHE_TTL_S=300
# Seconds for one SODA fetch, including retries. Past this, fall back to the snapshot.
SOCRATA_FETCH_BUDGET_S=20
# Seconds for the SODA refresh only (every pull in that refresh). Not the model.
# Not a cap on the whole briefing --online --live command.
# The model money cap is MAX_LIVE_SPEND_USD. Default 45 is under 6 pulls times 20 s.
SOCRATA_RUN_BUDGET_S=45

# Live model is OFF unless every live variable below is set on purpose.
LIVE_LLM=0
XAI_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
# Per 1M tokens. No prices are hardcoded in the app. Leave empty to refuse live calls.
LLM_PRICE_INPUT_PER_MTOK=
LLM_PRICE_OUTPUT_PER_MTOK=
MAX_LIVE_SPEND_USD=0.50
LLM_TIMEOUT_S=20
LLM_MAX_ATTEMPTS=2

# PUBLIC lab fixture for the approval gate (simulated actor). Not a production credential.
# It is in this file on purpose. Rotate it before any use outside demo mode.
# demo and eval may use it when the variable is unset. briefing refuses this value.
# Production needs an authenticated channel. Empty refuses to sign state on briefing.
APPROVAL_STATE_KEY=lab-simulated-not-a-secret
APPROVERS_PATH=config/approvers.json
SENSITIVE_CATEGORIES_PATH=config/sensitive_categories.json

RUBRIC_PATH=config/rubric.json
FIXTURE_DIR=fixtures
